{
  "name": "@clavex/react",
  "version": "1.1.0",
  "description": "React SDK for Clavex Identity Platform — useUser, useOrg, useSignIn, usePasskey, useAuthZen, ClavexWallet",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "clavex",
    "react",
    "hooks",
    "oidc",
    "oauth2",
    "passkey",
    "webauthn",
    "authzen",
    "identity",
    "authentication",
    "authorization"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/clavex-eu/clavex-sdk",
    "directory": "packages/react"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.19.40",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/react-dom": "^18.3.7",
    "react-dom": "^18.3.1"
  },
  "homepage": "https://github.com/clavex-eu/clavex-sdk#readme",
  "bugs": {
    "url": "https://github.com/clavex-eu/clavex-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
