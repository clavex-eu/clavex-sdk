{
  "name": "@clavex/ui",
  "version": "0.1.0",
  "description": "Headless React UI component library for Clavex authentication flows \u2014 SignInButton, PasskeyEnrollment, MFAChallenge, UserProfile, OrganizationSwitcher. Styleable with CSS variables.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/clavex-ui.css"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "sideEffects": [
    "*.css",
    "dist/clavex-ui.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean && cp src/styles/clavex-ui.css dist/clavex-ui.css",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --runInBand",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "clavex",
    "react",
    "ui",
    "components",
    "headless",
    "authentication",
    "passkey",
    "webauthn",
    "mfa",
    "oidc",
    "identity"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/clavex-eu/clavex-sdk",
    "directory": "packages/ui"
  },
  "peerDependencies": {
    "@clavex/react": ">=1.0.0",
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@clavex/react": "file:../react",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "ts-jest": "^29.4.15",
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.2"
  },
  "homepage": "https://github.com/clavex-eu/clavex-sdk#readme",
  "bugs": {
    "url": "https://github.com/clavex-eu/clavex-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
