{
  "name": "@clavex/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript/Node.js SDK for the Clavex Identity Platform management API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "clavex",
    "identity",
    "iam",
    "oidc",
    "sdk",
    "management"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/clavex-eu/clavex-sdk",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsup": "^8.0.0",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "ts-jest": "^29.1.2"
  },
  "homepage": "https://github.com/clavex-eu/clavex-sdk#readme",
  "bugs": {
    "url": "https://github.com/clavex-eu/clavex-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
